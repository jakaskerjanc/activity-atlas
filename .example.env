# Public Mapbox token for the base map (the free tier is enough). This is the
# only secret the demo data needs; without it the map is replaced by a note.
VITE_MAPBOX_TOKEN=
# Only for the live Garmin fetch.
GARMIN_PERSONAL_API_KEY=

# Optional Cloudflare R2 archive. Without these, everything stays in data/archive/.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# Read-only token on the same bucket. Deploy reads the database with it.
# R2_RO_ACCESS_KEY_ID=
# R2_RO_SECRET_ACCESS_KEY=
